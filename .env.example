APP_NAME="Kwv Tij Hmoob Xyooj"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=lo
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Vientiane

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Production: MySQL 8 / MariaDB 10.6+ (utf8mb4). Local quick start: DB_CONNECTION=sqlite
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kwvtij
DB_USERNAME=kwvtij
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# First Admin account (created by `php artisan db:seed` once). Change the password after first login.
ADMIN_NAME="ຜູ້ດູແລລະບົບ"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@2026

# Google OAuth (optional). Leave empty to hide the "ດຳເນີນການດ້ວຍ Google" button.
# Authorised redirect URI in Google Cloud Console: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Email (password reset). log = write to storage/logs/laravel.log instead of sending.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
