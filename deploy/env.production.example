# Production .env — copy to /var/www/kwvtij/.env and replace every <...> value.
# NEVER commit the real .env.
APP_NAME="Kwv Tij Hmoob Xyooj"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain>

APP_LOCALE=lo
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Vientiane

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kwvtij
DB_USERNAME=kwvtij
DB_PASSWORD=<password printed by server-setup.sh>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Backups kept per kind (database / files) in storage/app/private/backups
BACKUP_KEEP=14

# Password-reset email (SMTP, e.g. Google Workspace with an App Password)
MAIL_MAILER=smtp
MAIL_HOST=<smtp host>
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=<sending account>
MAIL_PASSWORD=<app password>
MAIL_FROM_ADDRESS=<no-reply@your-domain>
MAIL_FROM_NAME="Kwv Tij Hmoob Xyooj"

# Google OAuth (optional — leave empty to hide the Google button)
# Authorised redirect URI: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# First Admin (used once by `php artisan db:seed --force`; remove after install)
ADMIN_NAME="ຜູ້ດູແລລະບົບ"
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<strong temporary password>
